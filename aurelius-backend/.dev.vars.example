# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
ENVIRONMENT=development
APP_ORIGIN=http://localhost:8787
OTP_SECRET=replace-with-a-long-random-string
# npm run gen-signing-key, then paste the JWK here on one line:
SIGNING_KEY_JWK=
# Leave unset in development to print emails to the console instead:
# RESEND_API_KEY=
